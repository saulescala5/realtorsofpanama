# --- Frontend (Vite exposes only VITE_* vars) ---
# When set, the app switches from the local demo store to Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server / Edge functions (never expose to the browser) ---
SUPABASE_SERVICE_ROLE_KEY=
# Google OAuth is configured inside Supabase Auth → Providers → Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# LLM powering the assistant
ANTHROPIC_API_KEY=
